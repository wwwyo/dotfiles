// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "split",
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/vendor",
    "**/.hg",
    "**/.svn",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/__pycache__",
    "**/.cache",
    "**/.venv",
    "**/dist",
    "**/build",
    "**/coverage",
    // .agent, .agents は除外しない（gitignoreされていても検索対象にする）
    "!**/.agent",
    "!**/.agents"
  ],
  "debugger": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": false,
      "enabled": false
    }
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    },
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Frappé"
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "on_yank"
  },
  "ui_font_size": 14,
  "buffer_font_size": 12,
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "VSCode Dark Modern"
  },
  "indent_guides": {
    "background_coloring": "indent_aware"
  },
  "terminal": {
    "font_size": 12,
    "copy_on_select": false
  },
  "auto_update": true,
  "auto_install_extensions": {
    "biome": true,
    "catppuccin-icons": true,
    "csv": true,
    "dockerfile": true,
    "git-firefly": true,
    "github-dark-default": true,
    "html": true,
    "log": true,
    "prisma": true,
    "proto": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "vercel-theme": true,
    "vscode-dark-modern": true,
    "xml": true
  },
  "autosave": "on_focus_change",
  "outline_panel": {
    "dock": "left",
    "button": false
  },
  "tabs": {
    "git_status": true
  }
}
