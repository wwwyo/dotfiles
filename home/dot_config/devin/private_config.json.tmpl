{{- $local := dict -}}
{{- $path := joinPath .chezmoi.homeDir ".config" "devin" "config.json" -}}
{{- if lstat $path -}}
{{- $local = output "jq" "-c" $filter $path | fromJson -}}
{{- else -}}
{{- $local = output "jq" "-cn" $filter | fromJson -}}
{{- end -}}
{
  "version": 1,
  "agent": {{ if hasKey $local "a" }}{{ get $local "a" | toJson }}{{ else }}{{ `{"model":"swe-2-medium","preferred_family_models":{"swe-2":"swe-2-medium","fusion":"fusion-claude-opus-5-5-medium-sidekick-swe-2-medium"}}` | fromJson | toJson }}{{ end }},
  "read_config_from": {
    "claude": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^exec$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/deny-git-add-all.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ $orcaCommand | toJson }},
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ $orcaCommand | toJson }},
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ $orcaCommand | toJson }},
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ $orcaCommand | toJson }},
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ $orcaCommand | toJson }},
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompaction": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ $orcaCommand | toJson }},
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ $orcaCommand | toJson }},
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ $orcaCommand | toJson }},
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": {{ get $local "al" | toJson }},
    "deny": [
      "Read(**/.env.local)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Write(**/.env.local)",
      "Write(**/secrets/**)",
      "Exec(sudo)",
      "Exec(wget)",
      "Exec(nc)",
      "Exec(mongod)",
      "Exec(bq rm)",
      "Exec(bq load)"
    ],
    "ask": [
      "Exec(terraform)"
    ]
  },
  "sandbox": {
    "allowed_domains": {{ get $local "ad" | toJson }},
    "excluded": {
      "allow": [
        "Exec(agent-browser)",
        "Exec(say)",
        "Exec(aws)",
        "Exec(npx)",
        "Exec(open)",
        "Exec(bun)",
        "Exec(codex)",
        "Exec(container)",
        "Exec(devin)",
        "Exec(docker)",
        "Exec(gcloud)",
        "Exec(go)",
        "Exec(kubectl)",
        "Exec(npm)",
        "Exec(pnpm)",
        "Exec(scp)",
        "Exec(gh)",
        "Exec(git)",
        "Exec(terraform)",
        "Exec(vitest)",
        "Exec(psql)",
        "Exec(mysql)"
      ]
    }
  },
  "devin": {{ if hasKey $local "d" }}{{ get $local "d" | toJson }}{{ else }}{"org_id":"org_N6dZEjgnb5biUvFw"}{{ end }},
  "shell": {{ if hasKey $local "s" }}{{ get $local "s" | toJson }}{{ else }}{"setup_complete":true,"startup_messages_remaining":15}{{ end }},
  "theme_mode": {{ if hasKey $local "tm" }}{{ get $local "tm" | toJson }}{{ else }}"light"{{ end }},
  "show_path": {{ if hasKey $local "sp" }}{{ get $local "sp" | toJson }}{{ else }}true{{ end }},
  "include_gitignored_files": {{ if hasKey $local "ig" }}{{ get $local "ig" | toJson }}{{ else }}true{{ end }},
  "skip_workspace_trust": {{ if hasKey $local "wt" }}{{ get $local "wt" | toJson }}{{ else }}true{{ end }},
  "show_hints": {{ if hasKey $local "sh" }}{{ get $local "sh" | toJson }}{{ else }}false{{ end }},
  "auto_update": {{ if hasKey $local "au" }}{{ get $local "au" | toJson }}{{ else }}true{{ end }}
}
