#!/usr/bin/env bash

#MISE description="開発ツールのキャッシュを削除（閾値超過分のみ）"

set -uo pipefail

# 閾値(MB)。削除に再取得コストが伴うキャッシュは、ここを超えたときだけ消す。
# 閾値を無視して消したいときは 0 を渡す: GO_MOD_MB=0 mise run clean-cache
GO_MOD_MB="${GO_MOD_MB:-5000}"
GO_BUILD_MB="${GO_BUILD_MB:-5000}"
BUN_MB="${BUN_MB:-2000}"
NPM_MB="${NPM_MB:-2000}"
UV_MB="${UV_MB:-5000}"
CONTAINER_IMAGE_MB="${CONTAINER_IMAGE_MB:-3000}"
BREW_MB="${BREW_MB:-2000}"
MISE_CACHE_MB="${MISE_CACHE_MB:-2000}"
CODEX_CACHE_MB="${CODEX_CACHE_MB:-1000}"
PLAYWRIGHT_MB="${PLAYWRIGHT_MB:-2000}"
PUPPETEER_MB="${PUPPETEER_MB:-1000}"
UPDATER_MB="${UPDATER_MB:-300}"

GO_MOD_DIR="$(go env GOMODCACHE 2>/dev/null || echo "$HOME/go/pkg/mod")"
GO_BUILD_DIR="$(go env GOCACHE 2>/dev/null || echo "$HOME/Library/Caches/go-build")"
BUN_DIR="$HOME/.bun/install/cache"
NPM_DIR="$HOME/.npm/_cacache"
UV_DIR="$(uv cache dir 2>/dev/null || echo "$HOME/.cache/uv")"
# image の実体（layer blob）。snapshots/containers は build・実行中 container の分なので測らない
CONTAINER_CONTENT_DIR="$HOME/Library/Application Support/com.apple.container/content"
BREW_CACHE_DIR="$(brew --cache 2>/dev/null || echo "$HOME/Library/Caches/Homebrew")"
# cask / formula 更新時の展開先。更新が途中で止まると中身が残り続ける（7GB 溜まった実例あり）
BREW_TMP_DIR="$(brew --prefix 2>/dev/null || echo /opt/homebrew)/var/homebrew/tmp"
MISE_CACHE_DIR="$HOME/Library/Caches/mise"
PLAYWRIGHT_DIR="$HOME/Library/Caches/ms-playwright"
PUPPETEER_DIR="$HOME/.cache/puppeteer"

failed=""
freed_mb=0

size_mb() {
  [ -e "$1" ] || { echo 0; return; }
  du -sk "$1" 2>/dev/null | awk '{printf "%d", $1 / 1024; exit}'
}

# 閾値未満なら skip。skip が常態になるので、サイズと閾値を必ず出して
# 「消す必要がなかった」と「壊れて消せなかった」を出力から区別できるようにする
gated_step() {
  local label="$1" path="$2" limit_mb="$3"
  shift 3
  local size
  size="$(size_mb "$path")"
  if [ "$size" -lt "$limit_mb" ]; then
    printf '==> %-24s skip  (%5dMB < %5dMB)\n' "$label" "$size" "$limit_mb"
    return
  fi
  printf '==> %-24s clean (%5dMB >= %5dMB)\n' "$label" "$size" "$limit_mb"
  if "$@"; then
    freed_mb=$((freed_mb + size))
  else
    failed="$failed $label"
  fi
}

# 他の uv process（長時間の uv run 等）が cache lock を持つ間は clean が待ち続ける。
# --force で奪うと実行中の環境を壊すので、lock 待ちが timeout したら skip 扱いにする
uv_cache_clean() {
  local out
  if out="$(UV_LOCK_TIMEOUT=60 uv cache clean 2>&1)"; then
    return 0
  fi
  if grep -q 'waiting for lock' <<<"$out"; then
    echo "    uv cache in use by another uv process; skipped"
    freed_mb=$((freed_mb - $(size_mb "$UV_DIR")))
    return 0
  fi
  echo "$out" >&2
  return 1
}

# dir の中身だけを消す（dir 自体は残す）
clear_dir() {
  find "$1" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null
  [ -z "$(find "$1" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]
}

# brew 実行中の展開途中を消さないよう、brew process が無く 1 日以上触られていないものだけ消す
brew_tmp_clean() {
  [ -d "$BREW_TMP_DIR" ] || return 0
  # Apple Silicon（/opt/homebrew/Library/...）と Intel（/usr/local/Homebrew/Library/...）の両方に一致させる
  if pgrep -f 'Library/Homebrew/brew.rb' >/dev/null 2>&1; then
    echo "    brew is running; skipped"
    return 0
  fi
  # 直下の .caskroom / .cellar dir は brew の作業場所なので残し、その中身と直下の file だけを消す
  find "$BREW_TMP_DIR" -mindepth 1 -maxdepth 2 \( -path "$BREW_TMP_DIR/*/*" -o -type f \) \
    -mmin +1440 -exec rm -rf {} +
}

# 未参照分のみを回収するため再取得コストが無い。閾値を置かず毎回実行する
always_step() {
  local label="$1"
  shift
  printf '==> %-24s run\n' "$label"
  "$@" || failed="$failed $label"
}

gated_step "go modcache" "$GO_MOD_DIR" "$GO_MOD_MB" go clean -modcache
gated_step "go buildcache" "$GO_BUILD_DIR" "$GO_BUILD_MB" go clean -cache
gated_step "bun cache" "$BUN_DIR" "$BUN_MB" \
  bash -c 'find "$HOME/.bun/install/cache" -mindepth 1 -delete 2>/dev/null'
gated_step "npm cacache" "$NPM_DIR" "$NPM_MB" npm cache clean --force
gated_step "uv cache" "$UV_DIR" "$UV_MB" uv_cache_clean
if command -v container >/dev/null 2>&1 && container system status >/dev/null 2>&1; then
  # -a は未使用の tagged image も消す（再 pull・再 build のコストを閾値で受ける）
  gated_step "container images" "$CONTAINER_CONTENT_DIR" "$CONTAINER_IMAGE_MB" container image prune -a
else
  printf '==> %-24s skip  (container system not running)\n' "container images"
fi
if command -v brew >/dev/null 2>&1; then
  # --prune=all は最新版の download も消す。再 install 時に再 download するコストを閾値で受ける
  gated_step "homebrew cache" "$BREW_CACHE_DIR" "$BREW_MB" brew cleanup --prune=all -q
fi
# mise の tool download cache。install 済み tool には影響しない
gated_step "mise cache" "$MISE_CACHE_DIR" "$MISE_CACHE_MB" mise cache clear
# Playwright / Puppeteer の browser。古い版が版ごとに溜まる。消すと次回使用時に再 download
gated_step "playwright browsers" "$PLAYWRIGHT_DIR" "$PLAYWRIGHT_MB" clear_dir "$PLAYWRIGHT_DIR"
gated_step "puppeteer browsers" "$PUPPETEER_DIR" "$PUPPETEER_MB" clear_dir "$PUPPETEER_DIR"
# Codex app の HTTP / runtime cache。app 起動中は使用中の file を消さないよう skip
for d in "$HOME/Library/Caches/com.openai.codex" "$HOME/Library/Caches/Codex"; do
  label="codex cache ($(basename "$d"))"
  if pgrep -xq Codex; then
    printf '==> %-24s skip  (Codex app running)\n' "$label"
  else
    gated_step "$label" "$d" "$CODEX_CACHE_MB" clear_dir "$d"
  fi
done
# app の自動更新が落とした installer。適用後は不要
for d in "$HOME/Library/Caches/orca-updater" "$HOME/Library/Caches/nani-desktop-updater"; do
  gated_step "updater ($(basename "$d"))" "$d" "$UPDATER_MB" clear_dir "$d"
done

always_step "homebrew tmp (stale)" brew_tmp_clean
always_step "go testcache" go clean -testcache
# tracked config も tracked stub も要求せず、実行中 process の起動元でもない
# tool version だけを消す（stub や実行中の分は残る）
always_step "mise prune (unused)" mise prune -y
always_step "pnpm store prune" pnpm store prune
# simctl は full Xcode（simulator runtime）が無いマシンでは `xcrun: unable to
# find utility "simctl"` で必ず失敗する。Xcode 不在は閾値判定と無関係な
# 恒常的な環境要因なので、異常として exit 1 にすると毎回 failed 表示になる。
# utility の有無を先に確認し、無い環境では skip として報告する
# （Xcode があって実際に失敗した場合は従来どおり failed に載る）。
if xcrun --find simctl >/dev/null 2>&1; then
  always_step "simctl unavailable" xcrun simctl delete unavailable
else
  printf '==> %-24s skip  (simctl なし: Xcode / simulator runtime 未導入)\n' \
    "simctl unavailable"
fi

echo
echo "freed: ${freed_mb}MB (閾値超過分のみ。pnpm/simctl/mise prune/homebrew tmp の回収量は含まない)"
if [ -n "$failed" ]; then
  echo "failed:$failed"
  exit 1
fi
