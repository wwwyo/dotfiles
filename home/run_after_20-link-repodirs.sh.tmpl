#!/bin/sh

# repo 内 dir を丸ごと symlink する entries。chezmoi の per-file 管理にしない理由は
# .chezmoiignore 冒頭のコメント参照。chezmoi apply のたびに冪等で張り直す。
#
# 注意: link 先はこの apply を実行した workingTree を指す。worktree から apply すると
# worktree 内を指すため、常用は main checkout（canonical path）から apply すること。

set -eu

WT="{{ .chezmoi.workingTree }}"

# link_dir <repo 内 source> <deploy 先>
# target が実 dir / 実 file のときは明示的に失敗する。ln -sfn は実 dir を
# 置き換えずその中に link を作って成功を返す（macOS）ので、黙って進めると
# link だけ見えて中身は繋がっていない壊れた状態になる。衝突は手で解消する
link_dir() {
  src="$1"
  dst="$2"
  [ -d "$src" ] || { echo "skip (no source): $src"; return 0; }
  mkdir -p "$(dirname "$dst")"
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    echo "error: $dst is a real dir/file; move it away and re-run" >&2
    return 1
  fi
  ln -sfn "$src" "$dst"
  echo "link: $dst -> $src"
}

link_dir "$WT/.agents"                  "$HOME/.agents"
link_dir "$WT/home/dot_claude/hooks"    "$HOME/.claude/hooks"
link_dir "$WT/.claude/skills"           "$HOME/.claude/skills"
link_dir "$WT/.claude/agents"           "$HOME/.claude/agents"
link_dir "$WT/.agents/scheduled-tasks"  "$HOME/.claude/scheduled-tasks"
link_dir "$WT/.codex/rules"             "$HOME/.codex/rules"
link_dir "$WT/.codex/scripts"           "$HOME/.codex/scripts"
link_dir "$WT/.codex/hooks"             "$HOME/.codex/hooks"
link_dir "$WT/.codex/skills"            "$HOME/.codex/skills"
link_dir "$WT/.pi/agent/extensions"     "$HOME/.pi/agent/extensions"
link_dir "$WT/home/dot_config/git/hooks"   "$HOME/.config/git/hooks"
link_dir "$WT/home/dot_config/git/bin"     "$HOME/.config/git/bin"
link_dir "$WT/home/dot_config/mise/tasks"  "$HOME/.config/mise/tasks"

# ~/.ssh は SSH が権限を検査する。chezmoi が作る 0755 を 0700 に揃える
[ -d "$HOME/.ssh" ] || mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

# .claude/rules は廃止。旧 link.sh が張った symlink が残っていれば外す
if [ -L "$HOME/.claude/rules" ]; then
  rm -f "$HOME/.claude/rules"
  echo "unlink: $HOME/.claude/rules (廃止)"
fi

# .codex/automations は repo link を廃止 — Codex の automation runtime state
# (memory.md や -2 重複 dir) が symlink 経由で repo に書き戻されていた。
# automation の SSOT は .agents/scheduled-tasks/*/automation.toml + orca。
# 既存 symlink は実 dir に戻し、Codex の runtime 書き込みはローカルに留める
if [ -L "$HOME/.codex/automations" ]; then
  rm -f "$HOME/.codex/automations"
  mkdir -p "$HOME/.codex/automations"
  echo "unlink: $HOME/.codex/automations (runtime state は repo 管理外)"
fi
