[user]
	name = yuito.watanabe
	email = w.ytmrm11811@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
	program = ~/.config/git/bin/ssh-sign
[ghq]
  root = ~/src

# clearly makes git better

[color]
	ui = auto
[column]
	ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
        gpgsign = true
[init]
        defaultBranch = main
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[push]
	default = current
        autoSetupRemote = true
        followTags = true
[fetch]
        prune = true
        pruneTags = true
        all = true

# why the hell not?

[help]
        autocorrect = prompt
[commit]
        verbose = true
        gpgsign = true
	template = ~/.config/git/commit_template
[rerere]
        enabled = true
        autoupdate = true
[core]
        excludesfile = ~/.gitignore
	editor = vim
	ignorecase = false
	quotepath = false
[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true
[alias]
	st = status --short --branch
	ci = commit -v
	br = branch
	co = checkout
	s = switch
	sw = switch
	logo = log --oneline
	log1 = log -1
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[remote]
	pushDefault = origin
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
