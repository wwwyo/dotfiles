{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/deny-git-add-all.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
