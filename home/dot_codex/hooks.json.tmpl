{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/deny-git-add-all.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/skills/project-setup/tools/sync-local-worktree-files.sh\" --codex-session-start",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/codex-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
