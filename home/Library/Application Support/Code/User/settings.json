{
  "editor.renderWhitespace": "all",
  "files.autoSave": "onFocusChange",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true
  },
  "files.trimTrailingWhitespace": true,
  "window.title": "${activeEditorMedium}${separator}${rootName}",
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"]
    }
  ],
  "vim.hlsearch": true,

  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,

  "search.exclude": {
    "/node_modules": true
  },

  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook",
    "*.log": "default",
    "*.svg": "default"
  },
  "workbench.tree.renderIndentGuides": "always",
  "workbench.tree.indent": 14,

  "terminal.integrated.inheritEnv": false,

  "javascript.preferGoToSourceDefinition": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferGoToSourceDefinition": true,
  "typescript.updateImportsOnFileMove.enabled": "always",

  "workbench.editor.customLabels.patterns": {
    "**/index.*": "${dirname} .../${dirname(1)}",
    "**/{page,layout,template,route,actions}.{ts,tsx}": "${dirname}/${filename}.${extname} .../${dirname(1)}",
  },
  "editor.cursorStyle": "line",
  "editor.lineNumbers": "on",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?",
  "editor.wordWrap": "off",
  "editor.suggestSelection": "first",
  "editor.copyWithSyntaxHighlighting": false,
  "editor.minimap.enabled": false,
  "editor.inlineSuggest.enabled": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.formatOnSave": false,
  "editor.quickSuggestions": {
    "strings": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.addMissingImports": "explicit",
    "source.removeUnusedImports": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "editor.detectIndentation": true,
  "editor.accessibilitySupport": "off",

  "security.workspace.trust.untrustedFiles": "open",

  "[html]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[php]": {
    "editor.tabSize": 4
  },
  "[python]": {
    "editor.tabSize": 2,
    "editor.formatOnType": true
  },
  "[css]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "explicit"
    }
  },
  "[scss]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "explicit"
    }
  },
  "[astro]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[graphql]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[gql]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[ignore]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },

  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "vue",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [{ "mode": "auto" }],

  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },

  "gitlens.views.worktrees.files.layout": "list",
  "gitlens.mode.active": "review",
  "git.autofetch": true,
  "githubPullRequests.fileListLayout": "tree",
  "githubPullRequests.pullBranch": "never",
  "figma.autocompleteBlocks": true,
  "go.toolsManagement.autoUpdate": true,
  "go.alternateTools": {
    "go": "${env:HOME}/.local/share/mise/shims/go"
  },
  "errorLens.enabledDiagnosticLevels": ["error", "warning", "hint"],
  "auto-close-tag.enableAutoCloseSelfClosingTag": false,
  "html.autoClosingTags": false,
  "javascript.autoClosingTags": false,
  "typescript.autoClosingTags": false,
  "jest.runMode": {
    "type": "on-save",
    "testFileOnly": true
  },

  "tailwindCSS.experimental.classRegex": [
    [
      "cva\\(([^)(]*(?:\\([^)(]*(?:\\([^)(]*(?:\\([^)(]*\\)[^)(]*)*\\)[^)(]*)*\\)[^)(]*)*)\\)",
      "'([^']*)'"
    ]
  ],
  "git.confirmSync": false,
  "cSpell.userWords": [
    "Entrypoints",
    "esbenp",
    "Gorm",
    "mdast",
    "nextjs",
    "nuxtjs",
    "opentelemetry",
    "pnpm",
    "signin",
    "struct",
    "stylelint",
    "Threadsafe",
    "timeframe"
  ],
  "hediet.vscode-drawio.resizeImages": null,
  "window.zoomLevel": -1,
  "terminal.integrated.env.osx": {},
  "[css][scss]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "explicit"
    }
  },
  "gitlens.views.commits.files.layout": "tree",
  "gitlens.launchpad.indicator.enabled": false,
  "terminal.external.osxExec": "Warp.app",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "diffEditor.ignoreTrimWhitespace": false,
  "prettier.requireConfig": true,
  "editor.foldingImportsByDefault": true,
  "githubIssues.queries": [
    {
      "label": "自分の問題",
      "query": "is:open assignee:${user} repo:${owner}/${repository}",
      "groupBy": [
        "milestone"
      ]
    },
    {
      "label": "作成された問題",
      "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc"
    },
    {
      "label": "最近の問題",
      "query": "state:open repo:${owner}/${repository} sort:updated-desc"
    }
  ],
  "github.copilot.nextEditSuggestions.enabled": true,
  "githubPullRequests.pushBranch": "always",
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [
      80
    ],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": ".cursor/rules/9-commit-message-rule.mdc",
    }
  ],
  "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
    {
      "file": ".cursor/rules/9-pr-rule.mdc",
    }
  ],
  "editor.unicodeHighlight.nonBasicASCII": false,
  "docker.extension.enableComposeLanguageServer": false,
  "claudeCode.preferredLocation": "panel",
  "security.promptForLocalFileProtocolHandling": false,
}
