{
  "providers": {
    "openrouter": {
      "compat": {
        "openRouterRouting": {
          "data_collection": "deny"
        }
      }
    },
    "opencode-go": {
      "models": [
        {
          "id": "claude-haiku-5-5",
          "name": "Claude Haiku 5.5",
          "api": "anthropic-messages",
          "baseUrl": "https://opencode.ai/zen/go",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 128000,
          "cost": {
            "input": 0.1,
            "output": 0.5,
            "cacheRead": 0.01,
            "cacheWrite": 0.125,
            "tiers": [
              { "inputTokensAbove": 100000, "input": 0.5, "output": 2.5, "cacheRead": 0.05, "cacheWrite": 0.625 }
            ]
          },
          "compat": {
            "forceAdaptiveThinking": true,
            "supportsTemperature": false
          },
          "thinkingLevelMap": { "off": "off", "minimal": null, "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" }
        }
      ]
    }
  }
}
