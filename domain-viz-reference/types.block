// ----- 基本の型
type 文字 = string
type 数 = number
type 円 = number                 // 整数
type 人数 = number
type 年度 = number               // 会計年度の西暦（R7年度 = 2025）
type 日付 = string               // YYYY-MM-DD
type URL = string
type 自治体コード = string       // 全国地方公共団体コード（6桁）
type 科目ID = string             // 表の subject_id
type 内訳ID = string             // 表の detail_id
type 事業ID = string             // ★案
type COFOG = string              // COFOG分類マスタのコード
type 歳出の節 = string           // 歳出の節マスタの ID
type 都道府県 = '北海道' | '青森県' | '岩手県' | '宮城県' | '秋田県' | '山形県' | '福島県' | '茨城県' | '栃木県' | '群馬県' | '埼玉県' | '千葉県' | '東京都' | '神奈川県' | '新潟県' | '富山県' | '石川県' | '福井県' | '山梨県' | '長野県' | '岐阜県' | '静岡県' | '愛知県' | '三重県' | '滋賀県' | '京都府' | '大阪府' | '兵庫県' | '奈良県' | '和歌山県' | '鳥取県' | '島根県' | '岡山県' | '広島県' | '山口県' | '徳島県' | '香川県' | '愛媛県' | '高知県' | '福岡県' | '佐賀県' | '長崎県' | '熊本県' | '大分県' | '宮崎県' | '鹿児島県' | '沖縄県'
type 会計の種類 = '一般会計' | 'と場' | 'テレビ共同受信' | '下水道' | '中小企業設備導入等資金' | '介護サービス事業' | '介護保険' | '公債費' | '国民健康保険' | '土地区画整理' | '地方消費税清算' | '地方独立行政法人病院貸付' | '小笠原諸島生活再建資金' | '工業用水道清算' | '市営住宅' | '市場' | '市街地再開発' | '後期高齢者医療' | '心身障害者扶養年金' | '林業・木材産業改善資金' | '母子父子寡婦福祉資金貸付' | '沿岸漁業改善資金' | '災害復旧' | '特別区財政調整' | '用地' | '病院事業' | '病院施設' | '空港整備' | '競走事業' | '競輪事業' | '老人保健施設' | '臨海都市基盤整備' | '財産区' | '連続立体化' | '都営住宅' | '都営住宅保証金' | '都市開発資金' | '都民の森' | '食肉センター' | '駐車場' | '不明' // 対応表 account_kind_map が正。風土記の判断。自治体をまたぐ比較に使う
type 出典<形式 extends 'PDF' | 'CSV' | 'Excel' = 'PDF' | 'CSV' | 'Excel'> = {
  資料名: 文字                // 例: 令和7年度 品川区予算書
  URL: URL                    // 公式サイトの公開 URL（ファイルそのもの）
  形式: 形式
  SHA256: 文字                // 風土記が保存したファイルの指紋。ファイル本体は非公開の保管場所に置く
}

// ===== 自治体（root）
type 自治体 = {
  自治体コード: 自治体コード  // PK。この集約の ID
  名前: 文字                  // 武蔵野市
  都道府県: 都道府県          // FK。都道府県マスタ
  公式サイト: URL
}

// ===== 歳出（root）: 1つの資料の1つの会計の歳出全体
type 歳出 = {
  自治体: 自治体コード        // PK・FK
  年度: 年度                  // PK
  資料区分: '当初予算' | '決算' // PK。補正予算（第n号）は未収録
  会計: 会計                  // PK
  出典: 出典<'PDF' | 'CSV'>   // 値を取った予算書・決算書
  款: 款[]                    // ここから下が「歳出の行」
}
type 会計 = {
  名前: 文字                  // 出典の表記（一般会計・国民健康保険事業会計…）
  種類: 会計の種類
}
type 科目の共通 = {           // 款・項・目に共通の項目
  科目ID: 科目ID              // PK
  番号?: 文字                 // 資料に印字された款・項・目の番号（例: 「2 総務費」の 2）。同じ親の中でだけ重ならない
  名前: 文字
  金額: 円                    // PDF は印字の額、CSV の親は子の和。子の科目の和と合う（取り込みで検査し、資料の印字が合わないところは宣言済みのずれとして残す）
  印字の位置: 印字の位置
}
type 款 = 科目の共通 & {
  項: 項[]
}
type 項 = 科目の共通 & {
  目: 目[]                    // 目の無い項は空
  内訳: 内訳[]                // 科目と足さない
}
type 目 = 科目の共通 & {
  分野: 分野                  // 風土記の判断
  繰出先?: 会計の種類         // 他の会計への繰出金のとき（風土記の判断）
  内訳: 内訳[]                // 科目と足さない
}
type 分野 = 分類した分野 | 分類しない分野
type 分類した分野 = {
  確かさ: '確定' | '暫定'
  COFOG: COFOG                // FK
}
type 分類しない分野 = {
  確かさ: '分類できない' | '対象外'
}
type 内訳 = 事業の内訳 | 事業でない内訳 // 分け方は風土記の判断
type 内訳の共通 = {
  内訳ID: 内訳ID              // PK
  段の名前: 文字              // 内訳1・事項・節・細節…（印字の見出し）
  名前: 文字                  // 資料のまま
  法定の節?: 歳出の節         // FK。節マスタに当たった行だけ
  繰出先?: 会計の種類         // 他の会計への繰出金のとき（風土記の判断）
  金額: 円
  内訳の内訳: 内訳[]          // 深さは資料しだい
  印字の位置: 印字の位置
}
type 事業の内訳 = 内訳の共通 & {
  分け方: '事業'
  所管課?: 文字               // 名前の末尾の【】
}
type 事業でない内訳 = 内訳の共通 & {
  分け方: '節' | 'その他'
}
type 印字の位置 = PDFの位置 | CSVの位置 // 名前と金額が出典のどこに印字されているか。出典の形式で形が違う
type PDFの位置 = {
  名前の頁: 数                // ファイルの中で1から数えた頁
  名前の枠: 枠
  金額の頁?: 数
  金額の枠?: 枠               // 1つの印字が全額のときだけ
}
type CSVの位置 = {
  名前の行: 数                // ファイルの中の行番号
  金額の行?: 数
}
type 枠 = {                   // 頁の左上を原点にした pt
  左: 数
  上: 数
  右: 数
  下: 数
}
// 守ること: 末端の科目の和 = 総額。分け方の違う内訳どうしは足さない

// ===== 人口（root）
type 人口 = {
  自治体: 自治体コード        // PK・FK
  基準日: 日付                // PK
  男: 人数
  女: 人数
  総数: 人数
  世帯数: 数
  出典: 出典<'Excel'>         // 総務省の住民基本台帳の集計
}

// ===== 事業評価（root）: 自治体の1年度分の事務事業評価（評価結果の資料と評価シート全部）
type 事業評価 = {
  自治体: 自治体コード        // PK・FK
  事業を行った年度: 年度      // PK。評価した事業を実施した年度
  出典: 出典<'PDF'>           // 評価結果の資料
  件数: 評価の件数            // 評価結果の資料に載る数
  シート: 評価シート[]        // シートを取り込んでいない年度は空
}
type 評価の件数 = {
  評価した数: 数
  A: 数
  B: 数
  C: 数
  D: 数
}
type 評価シート = {           // 1枚 = 小事業の1年度。出典と頁で1枚が決まる
  事業?: 事業の年度の参照     // FK。★案。今は決算書の内訳から導く。決算書の無い年度など紐付かないシートもある
  事業名: 文字                // 小事業の名前。資料のまま
  予算科目: 予算科目          // シートに印字された予算科目。事業に紐付けた根拠
  部?: 文字                   // 担当部署。シートの表記
  課?: 文字                   // 担当課。シートの表記
  予算額: 円                  // 小事業の額。歳出の行とは足さない
  決算額: 円
  評価: 'A' | 'B' | 'C' | 'D'
  評価の名前?: 文字           // シートの表記。読めない欄は空（例: 改善・見直しする事業）
  今後の方向?: 文字           // シートの表記。読めない欄は空（例: 手法等の改善）
  指標: 指標[]
  出典: 出典<'PDF'> & { 頁: 数 } // PK
}
type 予算科目 = {             // 読めない欄は空
  会計?: 文字
  款?: 文字
  項?: 文字
  目?: 文字
  事業?: 文字
}
type 事業の年度の参照 = {
  事業: 事業ID
  年度: 年度
}
type 指標 = {
  名前: 文字
  単位?: 文字
  定義?: 文字
  最終目標?: 文字             // シートの表記のまま
  最終目標の年度?: 文字       // シートの表記のまま（例: 令和8年度）
  年度: 指標の年度[]
}
type 指標の年度 = {
  年度: 年度                  // PK
  目標?: 文字
  実績?: 文字
}
// 守ること: シートを取り込んだ年度は、評価シートの数・A〜D の数が 件数 と合う

// ===== 事業（root・★案）: 予算書の事業の行を1つずつ事業にし、年度をまたいでつないだ木（つなぎは風土記の判断）。最小単位は末端の事業
type 事業 = {
  事業ID: 事業ID              // PK
  自治体: 自治体コード        // FK
  名前: 文字                  // 最新の年度の表記
  始めた年度: 年度
  終えた年度?: 年度
  親の事業?: 事業ID           // FK。予算書の入れ子の1つ上の事業。目の直下の事業は持たない
  金額: 事業の金額[]          // 年度ごと
}
type 事業の金額 = {
  年度: 年度                  // PK
  当初予算の行?: 歳出の行の参照 // FK。紐付かない施策から作った事業は持たない
  決算の行?: 歳出の行の参照   // FK
  予算案での説明: 予算案での説明[] // 予算案の資料に載った年度だけ
}
type 歳出の行の参照 = 内訳の参照 | 目の参照
type 内訳の参照 = {           // その事業の行
  種類: '内訳'
  内訳ID: 内訳ID
}
type 目の参照 = {             // 事業の内訳が無い自治体。目の無い項を含む
  種類: '目'
  科目ID: 科目ID
}
type 予算案での説明 = {       // 予算案のプレス発表の資料の1施策。値（エンティティにしない）
  施策名: 文字
  事業名: 文字[]              // 資料の事業名の欄。複数のことがある
  新規: boolean               // 新規の印
  説明: 文字                  // 資料の説明文（品川は「ポイント」の箇条書き）
  予算額?: 円
  出典: 出典<'PDF'> & { 頁: 数 }
}
// 守ること: 1つの年度に 事業の金額 は1つ。事業の額を足すときは、その年度に子の事業の金額を持たない事業だけを足す
