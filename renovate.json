{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "mode": "full",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":timezone(Asia/Tokyo)"
  ],
  "minimumReleaseAge": "7 days",
  "schedule": ["after 9am on saturday"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    ".github/workflows/*.lock.yml"
  ],
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "commitMessagePrefix": "chore(mise):"
    },
    {
      "description": "openai/codex の tag は rust-v0.x 形式。aqua backend の既定 extractVersion は先頭の v しか落とせず候補が 0 件になるため明示する",
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:openai/codex"],
      "extractVersion": "^rust-v(?<version>.+)$"
    },
    {
      "description": "vercel は 58.5.1 以降 Sigstore provenance を付けずに公開しており、mise の npm backend（aube の trustPolicy=no-downgrade）が install を止める。provenance 付きの最後の版 58.4.4 に留め、provenance 付きの版が出たら外す",
      "matchManagers": ["mise"],
      "matchDepNames": ["npm:vercel"],
      "allowedVersions": "<=58.4.4"
    }
  ]
}
